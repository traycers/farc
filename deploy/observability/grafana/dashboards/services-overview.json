{
  "title": "Services Overview",
  "uid": "farc-services-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["farc"],
  "panels": [
    {
      "id": 1,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "go_goroutines{job=~\"farc|hls_server|msm_server\"}", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Resident memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=~\"farc|hls_server|msm_server\"}", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Uptime",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "time() - process_start_time_seconds{job=~\"farc|hls_server|msm_server\"}", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "hls_server connected channels",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "hls_server_connected_channels", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "msm_server WS connected to farcd",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "disconnected", "color": "red" }, "1": { "text": "connected", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "msm_server_ws_connected", "refId": "A" }
      ]
    }
  ]
}
