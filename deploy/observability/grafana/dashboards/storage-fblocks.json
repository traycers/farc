{
  "title": "Storage & Fblocks",
  "uid": "farc-storage-fblocks",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["farc"],
  "panels": [
    {
      "id": 6,
      "title": "RTSP-in vs storage-write byte rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "rate(farc_rtsp_bytes_received_total[5m])", "legendFormat": "rtsp in {{storage}}", "refId": "A" },
        { "expr": "sum(rate(farc_rtsp_bytes_received_total[5m]))", "legendFormat": "rtsp in total", "refId": "B" },
        { "expr": "rate(farc_storage_bytes_written_total[5m])", "legendFormat": "written {{storage}}", "refId": "C" },
        { "expr": "sum(rate(farc_storage_bytes_written_total[5m]))", "legendFormat": "written total", "refId": "D" }
      ]
    },
    {
      "id": 7,
      "title": "Fblock completion rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "rate(farc_fblocks_completed_total[5m])", "legendFormat": "{{storage}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Fblock catalog/TOC/content sizes",
      "type": "xychart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "topk(50, farc_fblock_catalog_size_bytes)", "legendFormat": "catalog {{storage}} {{fblock}}", "refId": "A", "instant": true, "format": "table" },
        { "expr": "topk(50, farc_fblock_toc_size_bytes)", "legendFormat": "toc {{storage}} {{fblock}}", "refId": "B", "instant": true, "format": "table" },
        { "expr": "topk(50, farc_fblock_content_size_bytes)", "legendFormat": "content {{storage}} {{fblock}}", "refId": "C", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "fblock", "mode": "outer" } }
      ],
      "options": {
        "seriesMapping": "manual",
        "series": [
          { "x": { "matcher": { "id": "byName", "options": "fblock" } }, "y": { "matcher": { "id": "byName", "options": "Value #A" } } },
          { "x": { "matcher": { "id": "byName", "options": "fblock" } }, "y": { "matcher": { "id": "byName", "options": "Value #B" } } },
          { "x": { "matcher": { "id": "byName", "options": "fblock" } }, "y": { "matcher": { "id": "byName", "options": "Value #C" } } }
        ]
      }
    },
    {
      "id": 4,
      "title": "Write-verify failures / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "rate(farc_write_verify_failures_total[5m])", "legendFormat": "{{storage}}", "refId": "A" }
      ]
    }
  ]
}
