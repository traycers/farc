FROM golang:1.26-bookworm AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /out/hls_server ./cmd/hls_server

FROM debian:12-slim AS runtime
WORKDIR /app
COPY --from=builder /out/hls_server ./hls_server
ENTRYPOINT ["./hls_server"]
CMD ["-c", "/etc/hls_server/hls_server.config.json"]
